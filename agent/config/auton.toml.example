[llm]
# Model using LiteLLM provider/model format
# Examples:
#   "anthropic/claude-opus-4-6"       - Claude (Anthropic)
#   "openai/gpt-4o"                   - GPT-4o (OpenAI)
#   "ollama/llama3.1"                 - Llama 3.1 (local via Ollama)
#   "gemini/gemini-2.0-flash"         - Gemini (Google)
#   "openrouter/anthropic/claude-3.5-sonnet" - via OpenRouter
#
# An "ollama/<tag>" model must appear in `ollama list` on the host named in
# [llm.endpoints]. The client preflights this at construction and fails with
# the available tags, rather than letting a typo surface as an empty
# completion partway through an agent run.
#
# QUALIFY A LOCAL MODEL BEFORE USING IT: `scripts/model-probe.py <model>` runs
# the four checks local models have actually failed here (calls a tool at all,
# file content survives the round trip, still works with a 25,000-character
# spec in the prompt, moves on after a tool result). Measured 2026-09-22:
#
#   ollama_chat/qwen3.5:27b   4/4, slowest call 492s
#   ollama_chat/qwen3.5:9b    4/4, slowest call 285s
#   ollama/gemma4:latest      3/4 — with a full spec in the prompt it writes
#                             pmm_init with the wrong parameter type
#
# Prefer `ollama_chat/` over `ollama/`: native tool calling, rather than
# asking the model to write JSON as text (which loses whitespace).
model = "anthropic/claude-opus-4-6"
max_tokens = 16384
temperature = 0.0

# How long one model call may take before the agent gives up. A local 27b with
# a full subsystem spec in the prompt takes ~500s, so the default 600s is close
# to the edge; raise it for slow local models.
# request_timeout = 1800.0

# How many tool calls one task may take (default 20). A model that reads the
# tree before writing spends turns on reading, and the useful ones come last:
# w14's F6 run wrote a working TFTP server and then hit the cap with its tests
# unwritten. Raise it for local models that explore.
# max_tool_turns = 60

[llm.cost]
# Budget limits per orchestration run
max_cost_usd = 50.0
warn_at_usd = 25.0

# API keys per provider (or use environment variables instead)
# Environment variables: ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY, etc.
[llm.api_keys]
# anthropic = "sk-ant-..."
# openai = "sk-..."
# gemini = "..."
# openrouter = "sk-or-..."

# Custom base URLs for self-hosted or proxy endpoints
[llm.endpoints]
# ollama = "http://localhost:11434"
# azure = "https://your-resource.openai.azure.com/"

[agents]
# Number of parallel developer agents
developer_count = 4
# Number of parallel reviewer agents
reviewer_count = 1
# Number of parallel tester agents
tester_count = 1

[agents.models]
# Override models per agent role (defaults to llm.model)
# Can use different providers per role for cost optimization
# manager = "anthropic/claude-opus-4-6"
# architect = "anthropic/claude-opus-4-6"
# developer = "anthropic/claude-sonnet-4-5-20250929"
# reviewer = "openai/gpt-4o"
# tester = "anthropic/claude-sonnet-4-5-20250929"
# integrator = "anthropic/claude-sonnet-4-5-20250929"

[workspace]
# Path to the git workspace where agents write kernel code
path = "../kernels/x86_64"
# Branch naming convention
branch_prefix = "agent"

[kernel]
# Target architecture: "x86_64", "aarch64", or "riscv64"
# Changing this reconfigures toolchain, QEMU, agent prompts, and boot protocol automatically.
arch = "x86_64"

# Optional overrides — these default from the architecture profile.
# Only set if you have a custom toolchain or QEMU build.
# cc = "x86_64-elf-gcc"       # default: derived from arch (e.g. aarch64-elf-gcc)
# as = "nasm"                 # default: derived from arch (nasm for x86_64, GNU AS for others)
# qemu = "qemu-system-x86_64" # default: derived from arch (e.g. qemu-system-aarch64)

[validation]
# Build timeout in seconds
build_timeout = 120
# QEMU test timeout in seconds
test_timeout = 60
# Enable composition validation (slower but catches Frankenstein effect)
composition_checks = true

[logging]
level = "INFO"
# Log file for agent interactions
agent_log = "logs/agents.jsonl"
# Log file for orchestrator
orchestrator_log = "logs/orchestrator.log"

[orchestrator]
# Cap the agent loop. The default is 50; a local model that cannot emit
# well-formed tool calls will otherwise spend all fifty iterations discovering
# that. Keep this small when pointing the loop at a local model.
max_iterations = 50
