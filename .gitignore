# Config files with secrets (use *.example as template)
agent/config/auton.toml
agent/config/*.toml
!agent/config/*.toml.example

# Environment files
.env
.env.*

# AUTON runtime metadata (created by agents in workspace)
.auton/

# Agent workspace output (generated at runtime)
agent/workspace/*
!agent/workspace/.gitkeep

# Logs
agent/logs/
logs/

# Build artifacts
build/
*.o
*.elf
*.bin
*.iso
*.img
dist/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
agent/build/
.eggs/
*.egg
.venv/
venv/

# SLM model artifacts (checkpoints + exports)
SLM/models/
*.pt
*.onnx
*.gguf

# Rust
agent/tools/target/
agent/tools/*/target/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code's own scratch stays out; the research record does not.
# .claude/PRPs holds the PRDs, the 90 closed plans and ~50 experiment reports,
# and docs/ cites those paths — a citation git ignores resolves for one person
# and nobody else, which is the phantom-citation defect this project refuses
# everywhere else.
.claude/*
!.claude/PRPs/
SLM/work/
SLM/models/exports/

# Local tool/agent scratch (not project source)
.logs/
.opencode/

# E2E run artifacts (serial logs, manifests, timings) — regenerated per run.
.artifacts/

# Kernel trees are agent-generated output, not source.
# README.md:11 — "We do not write the kernel. The agents do."
# The last hand-written reference is tag kernel-reference-v1; its structure is
# preserved in agent/kernel_spec/reference/ and its contracts in the spec.
kernels/

# Fetched vendor documents — downloadable, not redistributable (agent/hardware/README.md)
.cache/

# Private silicon findings under embargo (agent/hardware/disclosure/README.md)
.disclosure/
